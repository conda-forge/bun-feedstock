From: Julia Haag <julia.haag@quantco.com>
Date: Thu, 8 Oct 2026 13:14:31 +0200
Subject: [PATCH] Disable -Werror

---
 scripts/build/flags.ts | 1 -
 1 file changed, 1 deletion(-)

diff --git a/scripts/build/flags.ts b/scripts/build/flags.ts
index 64dcf877..1be829dc 100644
--- a/scripts/build/flags.ts
+++ b/scripts/build/flags.ts
@@ -734,7 +734,6 @@ export const bunOnlyFlags: Flag[] = [
       "-Wno-c++23-lambda-attributes",
       "-Wno-nullability-completeness",
       "-Wno-character-conversion",
-      "-Werror",
     ],
     when: c => c.unix,
     desc: "Treat most warnings as errors; suppress known-noisy ones",
