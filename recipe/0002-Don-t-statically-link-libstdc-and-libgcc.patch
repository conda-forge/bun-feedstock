From c9d8399695f65e67ddd53cd5c83aa23dcbb4a2be Mon Sep 17 00:00:00 2001
From: Julia Haag <julia.haag@quantco.com>
Date: Thu, 8 Oct 2026 13:14:41 +0200
Subject: [PATCH 2/7] Don't statically link libstdc++ and libgcc

---
 scripts/build/flags.ts | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/scripts/build/flags.ts b/scripts/build/flags.ts
index 021a4cee863..95e35d9ed6d 100644
--- a/scripts/build/flags.ts
+++ b/scripts/build/flags.ts
@@ -1304,11 +1304,6 @@ export const linkerFlags: Flag[] = [
     when: c => c.linux,
     desc: "Retry pthread_create EAGAIN caused by an in-flight execve",
   },
-  {
-    flag: ["-static-libstdc++", "-static-libgcc"],
-    when: c => c.linux && c.abi === "gnu",
-    desc: "Static C++ runtime (don't depend on host libstdc++)",
-  },
   {
     flag: ["-lstdc++", "-lgcc"],
     when: c => c.linux && c.abi === "musl",
